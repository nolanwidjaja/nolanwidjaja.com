---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;
const formattedDate = formatDate(date);
---

<Base title={`${title} — Nolan Widjaja`} description={description}>
  <Header />
  <main class="mx-auto w-full max-w-content flex-1 px-6 py-16">
    <article>
      <header class="mb-8">
        <h1 class="text-4xl font-bold sm:text-5xl">{title}</h1>
        <p class="mt-3 text-sm text-text-muted">{formattedDate}</p>
      </header>
      <hr class="mb-8 border-border" />
      <div class="prose">
        <slot />
      </div>
      <hr class="mt-12 border-border" />
      <a href="/blog" class="mt-6 inline-block text-sm">&larr; All posts</a>
    </article>
  </main>
  <Footer />
</Base>
