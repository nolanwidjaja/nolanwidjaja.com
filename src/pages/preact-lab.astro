---
import Page from '../layouts/Page.astro';

const steps = [
  { n: '01', title: 'Learn', body: 'Understand the grammar or writing concept.' },
  { n: '02', title: 'Practice', body: 'Work through PreACT/ACT English questions together.' },
  { n: '03', title: 'Diagnose', body: 'Identify what went wrong and why.' },
  { n: '04', title: 'Improve', body: 'Apply what was learned to the next practice set.' },
];

const topics = [
  'Grammar & Usage',
  'Punctuation',
  'Sentence Structure',
  'Organization',
  'Rhetorical Skills',
  'Test Strategy',
];

const setup = [
  { label: 'Cost', value: 'Free' },
  { label: 'Group size', value: '4–8 students' },
  { label: 'Sessions', value: 'Four 1-hour sessions leading up to the PreACT' },
  { label: 'Eligibility', value: 'District 30 eighth-grade students' },
];
---

<Page
  title="PreACT Lab — Nolan Widjaja"
  description="A small-group program helping District 30 eighth graders prepare for the PreACT."
>
  <!-- Header -->
  <header>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-bold sm:text-5xl">PreACT Lab</h1>
      <span
        class="rounded-full border border-border px-2.5 py-0.5 text-xs uppercase tracking-wide text-text-muted"
      >
        In progress
      </span>
    </div>
    <p class="mt-3 font-serif text-xl text-text-muted">Learn it. Share it. Measure the impact.</p>
  </header>

  <!-- The Problem -->
  <section class="mt-14">
    <h2 class="text-2xl font-semibold">The Problem</h2>
    <p class="mt-4">
      Many middle-school students begin preparing for the PreACT without knowing which grammar and
      writing skills they need to strengthen.
    </p>
  </section>

  <!-- Origin -->
  <section class="mt-14">
    <!-- TODO(nolan): This heading and paragraph carry your voice. Edit freely. -->
    <h2 class="text-2xl font-semibold">Why I started this</h2>
    <p class="mt-4">
      After preparing for the PreACT myself, I recognized that English questions require students to
      apply many grammar and writing concepts quickly and accurately. I created PreACT Lab to bring
      students together in small groups, share what I learned, and help other middle schoolers
      strengthen those same skills.
    </p>
  </section>

  <!-- The Framework: full-bleed surface tint -->
  <section class="full-bleed mt-14 bg-surface py-14">
    <div class="mx-auto max-w-content px-6">
      <h2 class="text-2xl font-semibold">The Framework</h2>
      <ol class="mt-8 space-y-8 font-mono">
        {
          steps.map((step) => (
            <li class="flex gap-5">
              <span class="text-lg font-semibold text-accent">{step.n}</span>
              <div>
                <p class="text-lg font-semibold text-text">{step.title}</p>
                <p class="mt-1 text-text-muted">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- What Students Practice -->
  <section class="mt-14">
    <h2 class="text-2xl font-semibold">What Students Practice</h2>
    <ul class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-text-muted">
      {
        topics.map((topic, i) => (
          <li class="flex items-center gap-3">
            <span>{topic}</span>
            {i < topics.length - 1 && <span aria-hidden="true" class="text-border">|</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- The Setup -->
  <section class="mt-14">
    <h2 class="text-2xl font-semibold">The Setup</h2>
    <dl class="mt-4 space-y-2">
      {
        setup.map((item) => (
          <div class="flex gap-3">
            <dt class="w-28 shrink-0 text-text-muted">{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- CTA -->
  <section class="mt-14">
    <a
      href="mailto:joinpreactlab@gmail.com"
      class="inline-block rounded bg-accent px-5 py-3 font-medium !text-white hover:bg-accent-hover max-sm:block max-sm:text-center"
    >
      Join PreACT Lab
    </a>
  </section>

  <!--
    Impact section placeholder.
    TODO(nolan): Add enrollment numbers, results, and student feedback once sessions have run.
  -->
</Page>
