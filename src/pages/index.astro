---
import Page from '../layouts/Page.astro';
import { getCollection } from 'astro:content';
import { formatDate, sortByDateDesc } from '../lib/posts';

const recentPosts = sortByDateDesc(await getCollection('blog')).slice(0, 3);
---

<Page title="Nolan Widjaja">
  <!-- Hero -->
  <section>
    <!-- Avatar: swap this div for an <img> when you have a real photo -->
    <div
      class="h-20 w-20 sm:h-24 sm:w-24 rounded-full border border-border bg-surface flex items-center justify-center"
      aria-hidden="true"
    >
      <svg
        class="h-10 w-10 sm:h-12 sm:w-12 text-text-muted"
        viewBox="0 0 24 24"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
      </svg>
    </div>
    <!-- TODO(nolan): Replace with a one-line descriptor in your own voice. -->
    <p class="mt-4 text-lg text-text-muted">
      Middle schooler in District 30. I build things to figure out how they work.
    </p>
    <div class="mt-5 flex gap-5 text-sm">
      <a href="https://github.com/nolanwidjaja" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:nolanwidjaja@gmail.com">Email</a>
    </div>
  </section>

  <!-- About -->
  <section class="mt-16">
    <!-- TODO(nolan): Rewrite this section in your own words before launch. -->
    <p class="mb-5">
      I’m a middle school student who spends a lot of time on the things that don’t show up on a report card: figuring out how I learn best, building small projects, and writing about what I learn along the way.
    </p>
    <p>
      Right now, most of my energy goes into PreACT Lab, a small group I’m putting together to help other eighth graders get ready for the PreACT. This site is where I keep track of that work and whatever comes next.
    </p>
  </section>

  <!-- Projects -->
  <section class="mt-16">
    <h2 class="text-3xl font-semibold">Projects</h2>
    <ul class="mt-6 space-y-4">
      <li>
        <div class="flex items-baseline justify-between gap-4">
          <a href="/preact-lab" class="text-lg">PreACT Lab</a>
          <span class="shrink-0 text-sm text-text-muted">In progress</span>
        </div>
        <p class="mt-1 text-text-muted">
          A free, small-group program helping District 30 eighth graders strengthen the English and grammar skills tested on the PreACT.
        </p>
      </li>
    </ul>
  </section>

  <!-- Writing -->
  <section class="mt-16">
    <h2 class="text-3xl font-semibold">Writing</h2>
    <ul class="mt-6 space-y-3">
      {
        recentPosts.map((post) => (
          <li class="flex items-baseline justify-between gap-4">
            <a href={`/blog/${post.id}`} class="text-lg">
              {post.data.title}
            </a>
            <span class="shrink-0 text-sm text-text-muted">{formatDate(post.data.date)}</span>
          </li>
        ))
      }
    </ul>
    <a href="/blog" class="mt-6 inline-block text-sm">All posts &rarr;</a>
  </section>

  <!-- GitHub -->
  <section class="mt-16">
    <p class="text-text-muted">
      My code lives on
      <a href="https://github.com/nolanwidjaja" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </section>
</Page>
